{
  "name": "dsh-mindmap-live",
  "version": "0.2.0",
  "license": "MIT",
  "author": "SSShooter",
  "homepage": "https://github.com/SSShooter/dsh-mindmap-live#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSShooter/dsh-mindmap-live.git"
  },
  "bugs": {
    "url": "https://github.com/SSShooter/dsh-mindmap-live/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "mindmap",
    "mind-elixir"
  ],
  "files": [
    "lib",
    "dsh.bundle.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "description": "DSH web plugin: a live, bidirectional mind map built on the mind-elixir-core kernel. The agent and the user edit the same tree in real time through a session projection and a Connection RPC channel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "mind-elixir": "^6.0.0-next.4"
  }
}
